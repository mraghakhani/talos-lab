# Core lab settings
LAB_NAME=talos-lab
CLUSTER_NAME=talos-lab
LIBVIRT_URI=qemu:///system
LAB_NETWORK=192.168.231.0/24
LAB_GATEWAY=192.168.231.1
LAB_NETMASK=255.255.255.0
LAB_BRIDGE=virbr231
K8S_API_VIP=192.168.231.10

# Node IPs, MACs and resources live only in config/nodes.yaml.

# Reserved address ranges
DHCP_DYNAMIC_START=192.168.231.100
DHCP_DYNAMIC_END=192.168.231.180
CILIUM_LB_START=192.168.231.200
CILIUM_LB_END=192.168.231.220

# Cluster networks
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# Host HTTP CONNECT proxy used by Talos nodes for external image pulls.
# Host-side downloads use 127.0.0.1:${PROXY_PORT}; VMs use PROXY_HOST.
PROXY_SCHEME=http
PROXY_HOST=192.168.231.1
PROXY_PORT=10808

# Talos is deliberately pinned for reproducibility.
TALOS_VERSION=v1.14.0
TALOS_ARCH=amd64
TALOS_ISO_NAME=metal-amd64.iso
TALOS_RELEASE_BASE_URL=https://github.com/siderolabs/talos/releases/download

# libvirt storage
LIBVIRT_POOL=talos-lab
LIBVIRT_POOL_PATH=/var/lib/libvirt/images/talos-lab

# Previous talosctl QEMU cluster, retained only for cleanup tooling.
OLD_CLUSTER_NAME=talos-default

# DNS namespace used by later platform milestones.
LAB_DOMAIN=lab.dudes.cfd
